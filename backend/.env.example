# ==============================================================================
# TelConnect Backend Environment Configuration (.env.example)
# ==============================================================================

# Server Port (Default 7860 on Hugging Face Spaces, 8000 locally)
PORT=7860

# CORS Allowed Origins (Comma-separated list of origins for production)
# Example: https://telconnect-app.vercel.app,http://localhost:5173
CORS_ORIGINS=https://your-frontend.vercel.app,http://localhost:5173

# Groq Cloud API Key (Free Tier LLM & Whisper STT)
# Obtain a free key at: https://console.groq.com
GROQ_API_KEY=gsk_your_free_groq_api_key_here

# Geoapify Geocoding API Key (Free Tier Geolocation)
# Obtain a free key at: https://www.geoapify.com
GEOAPIFY_API_KEY=your_free_geoapify_api_key_here

# Optional: Groq LLM & Whisper Model Overrides
GROQ_MODEL=llama-3.3-70b-versatile
GROQ_WHISPER_MODEL=whisper-large-v3-turbo

# Optional: RAG Vector Store & Embeddings Configuration
EMBEDDING_MODEL=all-MiniLM-L6-v2
CHROMA_DB_PATH=backend/data/chroma_db
CHROMA_COLLECTION_NAME=telecom_rag_kb
TOP_K=3

# Optional: Background Scheduler Settings
TCI_SCHEDULER_INTERVAL=60
TCI_DISABLE_SCHEDULER=0
